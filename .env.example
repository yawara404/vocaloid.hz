# ---------------------------------------------------------------------------
# vocaloid.hz 環境変数
#   cp .env.example .env して、必要な値だけ埋める。
#   「任意」と書いてあるものは未設定でもアプリは起動する。
# ---------------------------------------------------------------------------

# --- サイト / 配信 ----------------------------------------------------------
# dev サーバーに許可するホスト（カンマ区切り）。トンネル公開時だけ設定する。
# 例: NUXT_DEV_ALLOWED_HOSTS=dev.example.com,another.example.com
NUXT_DEV_ALLOWED_HOSTS=

# サブパス配信するときの baseURL（末尾スラッシュ必須）。既定はルート配信。
# NUXT_APP_BASE_URL=/vocaloid-hz/

# デモユーザーの初期パスワード。初回起動時の seed にだけ使う（既定 vocaloid.hz）。
# 本番で seed する場合は必ず変更する。
# NUXT_SEED_PASSWORD=change-me

# SQLite の保存先（既定 ./data/vocaloid.hz.db）
# NUXT_DB_PATH=./data/vocaloid.hz.db

# --- YouTube Data API v3（任意）--------------------------------------------
# 再生数・マイルストーン表示に使う。未設定でも埋め込み再生と oEmbed は動く。
YOUTUBE_DATA_API_KEY=your_youtube_data_api_key

# --- AI ラウンジ（Ollama / gemma, 任意）------------------------------------
# NUXT_OLLAMA_KEEP_ALIVE は gemma を VRAM に載せておく時間。
# 既定は 5m（使ってから 5 分でアイドル＝アンロードに戻る）。-1 で常時ロード。
NUXT_OLLAMA_URL=http://localhost:11434/api/chat
# NUXT_OLLAMA_MODEL は使うモデル。既定は 4B の標準版（約 3.3GB）。
# 8bit 量子化の gemma3:4b-it-q8_0（約 5GB）より軽く、VRAM も抑えられる。
NUXT_OLLAMA_MODEL=gemma3:4b
NUXT_OLLAMA_KEEP_ALIVE=5m

# AI ラウンジで店主（gemma）がひとりごとを呟く間隔（ミリ秒）。既定は 120000 ≒ 2 分に 1 回。
# 「店主さん」（英語なら shopkeeper / Mr. Shopkeeper など）と呼ばれたときの返事は、この間隔を待たずにすぐ返す。
NUXT_LOUNGE_AI_INTERVAL_MS=120000

# --- OAuth（任意。未設定のプロバイダーはログイン画面に出ない）----------------
# コールバック URL: <サイトの origin>/api/auth/oauth/<google|discord>/callback
# NUXT_GOOGLE_CLIENT_ID=
# NUXT_GOOGLE_CLIENT_SECRET=
# NUXT_DISCORD_CLIENT_ID=
# NUXT_DISCORD_CLIENT_SECRET=

# --- Discord 中継（任意 / 旧チャット API 用）--------------------------------
# NUXT_DISCORD_WEBHOOK_URL=
# NUXT_DISCORD_BOT_TOKEN=
# NUXT_DISCORD_CHANNEL_ID=
